# Copy to `.env` and edit if the defaults don't fit. Expo inlines EXPO_PUBLIC_* at build time,
# so restart `expo start` after changing these.

# FastAPI backend. Default assumes the Android emulator, where 10.0.2.2 is the host machine.
# Physical device on Wi-Fi: use your machine's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_BASE=http://10.0.2.2:8000

# Static server for the menu photos and restaurant images that live in `frontend/public`.
# The running Vite dev server already serves them, hence :5173.
EXPO_PUBLIC_MEDIA_BASE=http://10.0.2.2:5173
